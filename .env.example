# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# PostgreSQL connection string.
#   Local dev with Docker:  postgresql://postgres:postgres@localhost:5432/bn_associates
#   Vercel Postgres:        provided automatically as DATABASE_URL when you link the store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bn_associates?schema=public"

# Only needed if your host requires a separate non-pooled connection for migrations.
# Vercel Postgres: set this to POSTGRES_PRISMA_URL and uncomment `directUrl` in schema.prisma.
# DIRECT_URL=""

# The real domain in production, e.g. https://bn-associates.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Dealer login for /admin — change both before deploying.
ADMIN_EMAIL="preetpal@bnassociates.in"
ADMIN_PASSWORD="ChangeMe@123"
